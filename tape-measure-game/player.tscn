[sub_resource type="GDScript" id="GDScript_4flbx"]
script/source = "extends RigidBody2D
@onready var floor_ray: RayCast2D = $RayCast2D
var is_on_floor: bool = false

func _physics_process(delta: float) -> void:
	is_on_floor = floor_ray.is_colliding()
	if Input.is_action_just_pressed(\"Left\"):
		apply_torque_impulse(5000000)
	if Input.is_action_just_pressed(\"Right\"):
		apply_torque_impulse(-5000000)
	if Input.is_action_just_pressed(\"Up\") && is_on_floor == true:
		apply_impulse(Vector2(0,-50000))
	$RayCast2D.global_rotation = 0
	


	


func _on_button_pressed() -> void:
	pass # Replace with function body.
"

